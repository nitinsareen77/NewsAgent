# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
# Anthropic API key for Claude scoring & report generation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Email (required for --email flag / GitHub Actions daily run) ───────────────
# Gmail: generate a 16-char App Password at myaccount.google.com/apppasswords
#        (requires 2-Step Verification to be enabled on the account)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=your-sender@gmail.com
EMAIL_TO=you@revantage.com,colleague@revantage.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Optional overrides ────────────────────────────────────────────────────────
# REPORT_DIR=reports
# SCORE_THRESHOLD=65
# CLAUDE_MODEL=claude-opus-4-6
# MAX_ITEMS_PER_SOURCE=12
# LOG_LEVEL=INFO
